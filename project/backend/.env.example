# Database
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/supportnova

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# JWT
JWT_SECRET_KEY=random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173

# Environment
ENVIRONMENT=development

# Email complaint intake (IMAP fetch + SMTP auto-reply). Leave EMAIL_INTAKE_ENABLED=false
# until these are filled in -- the poller never starts otherwise.
EMAIL_INTAKE_ENABLED=false
EMAIL_INTAKE_ADDRESS=supportnovaltd@gmail.com
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=supportnovaltd@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_POLL_INTERVAL_MINUTES=30
